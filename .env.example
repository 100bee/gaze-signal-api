GAZE_SIGNAL_DATABASE_URL=sqlite:///./data/gaze_signal_api.db
GAZE_SIGNAL_HOST=127.0.0.1
GAZE_SIGNAL_PORT=8000
GAZE_SIGNAL_LOG_LEVEL=INFO
GAZE_SIGNAL_ALLOWED_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
GAZE_SIGNAL_CAMERA_INDEX=0
GAZE_SIGNAL_FRAME_WIDTH=640
GAZE_SIGNAL_FRAME_HEIGHT=480
GAZE_SIGNAL_TARGET_FPS=15.0
GAZE_SIGNAL_FACE_MODEL_PATH=./models/face_landmarker.task
GAZE_SIGNAL_YOLO_ENABLED=false
GAZE_SIGNAL_YOLO_MODEL_PATH=./models/yolo11n.pt
GAZE_SIGNAL_YOLO_CONFIDENCE=0.45
GAZE_SIGNAL_YOLO_EVERY_N_FRAMES=10
GAZE_SIGNAL_DEBOUNCE_MS=350
GAZE_SIGNAL_AWAY_MIN_DURATION_MS=1000
GAZE_SIGNAL_EMA_ALPHA=0.35
GAZE_SIGNAL_STORE_RAW_FRAMES=false
